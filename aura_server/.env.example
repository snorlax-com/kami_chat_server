NODE_ENV=production
HOST=0.0.0.0
PORT=8000
KAMI_FACE_ORACLE_DIR=/root/kami_face_oracle

# Firebase ID トークン検証（Render / ローカルと同じ JSON）
FIREBASE_SERVICE_ACCOUNT_PATH=/root/secure/firebase-service-account.json

# 管理用 API キー（任意・ヘッダ X-API-Key）
API_KEY=

CORS_ALLOWED_ORIGINS=https://auraface.jp
FORCE_HTTPS=true
MAX_UPLOAD_BYTES=5242880
SAVE_DEBUG_IMAGES=false
CONSENT_DB_PATH=/root/aura_server/data/consents.sqlite

RATE_LIMIT_PREDICT=30/minute
RATE_LIMIT_VALIDATE=60/minute

# ローカル開発のみ
# IDENTITY_DEV_SECRET=local-dev-secret
# IDENTITY_DEV_UID=test-user
