NODE_ENV=production
PORT=3000
JWT_SECRET=長いランダム文字列をここに設定
ADMIN_EMAIL=管理者メール
ADMIN_PASSWORD_HASH=node scripts/hashPassword.js で生成したbcryptハッシュ
DATABASE_PATH=./data/app.db
IDENTITY_DB_DIR=./data
GOOGLE_PLAY_PACKAGE_NAME=com.auraface.kami_face_oracle
# ローカル検証用 JSON パス
GOOGLE_APPLICATION_CREDENTIALS=./secure/google-play-service-account.json
# Render 用（npm run play:sa-b64 → render:upsert-play-sa-b64）
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_B64=
RESEND_API_KEY=
MAIL_FROM=
BASE_URL=https://kami-chat-server.onrender.com
TOKEN_SECRET=メール返信リンク用HMAC秘密
CORS_ALLOWED_ORIGINS=https://auraface.jp,https://admin.auraface.jp
FIREBASE_SERVICE_ACCOUNT_JSON_B64=

# ローカル開発のみ
# IDENTITY_DEV_SECRET=
# IDENTITY_DEV_UID=
